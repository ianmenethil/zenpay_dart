PORT=7000

# Public HTTPS address of THIS server. Everything ZenPay is told to call is
# derived from it:
#   redirectUrl = <PUBLIC_BASE_URL>/return
#   callbackUrl = <PUBLIC_BASE_URL>/api/v1/callbacks
#
# localhost works until you need a real payment: ZenPay's callback is
# server-to-server, so it cannot reach your machine. Expose port 7000 and paste
# the https URL here:
#
#   cloudflared tunnel --url http://localhost:7000
#
# If you have a personal ~/.cloudflared/config.yml with `ingress` rules, pass
# --config with a file that has none, or its catch-all will answer every request
# to the quick tunnel instead of forwarding to this server.
PUBLIC_BASE_URL=http://localhost:7000

# Origin the sample app is served from, compared literally against the browser's
# Origin header. http://localhost:3000 and http://127.0.0.1:3000 are NOT the same
# origin.
ALLOWED_APP_ORIGIN=http://localhost:3000

MERCHANT_APP_BEARER_TOKEN=local-demo-token

# Where the return broker sends the browser once it has verified the correlation,
# with only `merchantUniquePaymentId` attached. Both must be HTTPS.
#
# The app names its kind ("web" or "mobile") when creating an attempt and the
# backend picks the matching URI below. It never accepts a URL from the client,
# so neither of these can be turned into an open redirect.

# WEB — the origin the sample app is served from. It must be HTTPS, so generate
# a locally trusted certificate once, from samples/app:
#
#   mkcert -install                    # once per machine
#   mkcert localhost 127.0.0.1 ::1     # writes localhost+2.pem and -key.pem
#
# `dart run melos run web` then serves https://localhost:3000. Set ALLOWED_APP_ORIGIN to
# the same origin without the trailing slash. The app reads its own address
# from Uri.base at runtime, so nothing needs to be configured on that side.
#
# This must match the origin the web app is actually served from. The SDK
# compares the session's returnUri against the app's own origin and rejects a
# mismatch before launching, so pointing this anywhere else makes web checkout
# fail with `Return URI does not match application policy` rather than
# misbehave quietly.
APP_RETURN_URI_WEB=https://localhost:3000/


# The full HCP Authorise endpoint, path included. createZpCheckoutUrl appends
# /<merchantCode>/Authorise to it, and the request schema rejects anything that
# is not a Zenith .../Online/v4 or .../Online/v5 URL.
ZENPAY_HPP_ENDPOINT_URL=https://pay.sandbox.travelpay.com.au/Online/v5
ZENPAY_MERCHANT_CODE=
ZENPAY_API_KEY=

# Required for BOTH launch and callback verification. They never leave this
# backend and are never sent anywhere: they are hashed into the SHA3-512
# fingerprint, and used again to recompute a callback's ValidationCode.
ZENPAY_USERNAME=
ZENPAY_PASSWORD=

ZENPAY_ALLOWED_CHECKOUT_HOSTS=pay.sandbox.travelpay.com.au
CHECKOUT_STATUS_TTL_MINUTES=60

# Optional. Signs a per-attempt `?t=` token embedded in the callbackUrl sent
# to ZenPay, verified (best-effort, logged only) when the callback arrives —
# see security.dart's checkCallbackToken. Separate from ZENPAY_PASSWORD, at
# least 32 bytes, blank disables the feature entirely. Generate with:
#
#   openssl rand -hex 32
CALLBACK_TOKEN_SECRET=
